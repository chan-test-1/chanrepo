특별한 메타 문자
[]
- 대괄호 안에 있는 문자들 중 하나와 일치
- -를 사용하여 범위를 지정 ex) [a-z]는 소문자 알파벳과 일치
- 대괄호 내의 일부 문자는 기존의 정규식 의미와 다른 특수한 의미를 가짐
    ex) [^a-z]   // ^는 시작문자가 아니다.  [^a-z]는 소문자 알파벳이 아닌 문자를 의미를

let regex = /[aeiou]/g;
console.log("hello world".match(regex)); // (대괄호 안에 있는 문자들 중 하나와 일치.) 결과: ["e", "o", "o"]


let regex = /[a-z0-9]/g; // 소문자 a~z , 0~9
console.log("abc123".match(regex)); // 결과 : ['a','b','c','1', '2', '3']

let regex = /[A-Z0-9]/g; // 대문자 A~Z , 0~9
let regex = /[a-z0-9]/gi; // i는 대소문자 무시


let regex = /[^0-9]/g; // 0-9 제외한 모든 문자.
console.log("abc123".match(regex)); // 결과 : ['a','b','c']

()
- 소괄호는 하위 표현식을 그룹화하여 하나의 단위로 취급
- 일치하는 문자열을 캡처하여 나중에 사용
- 캡쳐되지 않은 그룹은 (?:)로 표시

let phone = "010-1234-5678"
let regex = /\d{3}-\d{4}-\d{4}/g;        //\d{3} 숫자 3개, \d{4} 숫자4개, \d{4} 숫자4개

let formatted = phone.replace(regex, "abc");      // replace = 변경      regex 패턴은 핸드폰번호 전체를 찾은거고 그걸 abc로 replace한다고 한거니
console.log(formatted); // 결과: abc


let regex = /(\d{3})-(\d{4})-(\d{4})/g;    // 첫번째 괄호는 1번그룹 , 그다음은 2번그룹, 그다음은 3번그룹.

let formatted = phone.replace(regex, "$3-$2-$1");  // 그룹의 순서를 바꿔서 표현하고싶다.
console.log(formatted);  // 결과 : 5678-1234-010


let formatted = phone.replace(regex, "$3-4321-$1");  // 그룹의 순서를 바꾸면서 두번째 값만 바꾸고싶다.
console.log(formatted);  // 결과 : 5678-4321-010


let regex = /(\d{3})-(\d{4})-(\d{4})/;  // match 배열로 만들기 위해서는 /g 글로벌옵션을 뺴줘야된다고 함

let match = phone.match(regex);
console.log(match); // ['010-1234-5678', '010', '1234', '5678']    match를 하면 이렇게 배열안에 그룹화된 정보가 들어간다.

if(match){
    let areaCode = match[1];
    let mainNumber = `${match[2]}-${match[3]}`;

    console.log(`지역 코드 : ${areaCode}`); //010
    console.log(`번호: ${mainNumber}`); //1234-5678
}   



