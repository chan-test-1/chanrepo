문자열 객체 메소드

trim()
- 문자열의 양 끝에 있는 공백을 제거 (회원가입할 때 아이디같은거 공백)

let str = "   Hello World  "
console.log(str.trim()) ;// Hello world


toUpperCase() 
- 문자열을 대문자로 변환

let str = "hello world"
console.log(str.toUpperCase()); // HELLO WORLD


toLowerCase()
- 문자열을 소문자로 변환

let str = "HELLO WORLD"
consoel.log(str.toLowerCase()); // hello world


includes()
- 문자열이 특정 문자열을 포함하고 있는지 확인.

let str = "hello world";
console.log(str.includes("world")); // true

let str = "011-234-4567";

if(str.includes("011")){
    console.log("SKT 입니다")
}; 


replace()
- 문자열에서 특정 패턴을 다른 문자열로 교체

let str = "hello world"
console.log(str.replace("world", "javaScript")); // hello javaScript


split() 
- 문자열을 지정된 구분자를 기준으로 분할하여 배열로 반환

let str = '010-1234-1234' 
console.log(str.split('-'));  ['010','1234',1234]

let str = 'apple, banana, cherry' 
console.log(str.split(', '));   ['apple', ' banana', ' cherry']



fromCharCode()
- 아스키 코드 값을 사용하여 문자를 생성하는 메서드
- String.fromCharCode(code1, cod2, ..., codeN); // 아스키코드는 컴퓨터가 문자를 숫자로 표현하기 위해 만든 표준. 파라미터는 10진수가 들어가며 65부터 A다.

let char1 = String.fromCharCode(65);
console.log(char1); // A

let char2 = String.fromCharCode(65, 66)
console.log(char2); // AB


charCodeAt()
