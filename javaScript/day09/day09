try...catch 문 이란?
- 오류가 발생할 수 있는 코드 블록을 실행하고, 오류가 발생했을 때 이를 처리하는 구조
- 이 구문은 예외 처리 메커니즘을 제공하여 코드의 안정성을 높이는데 사용.

try {
    // 오류가 발생할 가능성이 있는 코드
} catch(error) {
    // 오류가 발생하면 실행되는 코드
}

try : 코드 블로갠에서 오류가 발생할수 있는 코드를 포함, 이 블록안에서 오류가 발생하면 제어가 catch 블록으로 이동.
catch : try 블록 내에서 오류가 발생하면 실행되는 코드

참조 오류
try {
    let x = y + 10;

    console.log('정상코드 실행') ;// 위에서 에러났으므로 표시되지않음 
} catch(error) {
    console.log(error) ;// referenceError(참조오류)
    console.log('오류발생 : ', error.message);  // y is not defined
}


타입 오류
try {
    let obj = null;
    console.log(obj.name) ;
} catch(error) {
    console.log(error) ;// typeError(타입오류)
    console.log('오류발생 : ', error.message);  // cannot read properties of null (reading 'name')    name을 읽을 수 없다.
}


구문 오류
try {
    console.log('hello'  ; // 괄호를 닫지 않았다.
} catch(error) {
    console.log(error) ;// syntaxError(타입오류)
    console.log('오류발생 : ', error.message);  // Uncaught SyntaxError: missing ) after argument list 

}


명시적 오류 발생 ; // 일부러 발생시키는 . 만약 if(a)이면 에러를 발생시켜 catch문으로 이동하게끔.
try {
    
    const a = true;
    
    if(a){
        throw new Error("문제가 발생했습니다!!")  ;// 에러가 발생하면 던지겠다(throw)
    }
    
    
} catch(error) {
    console.log(error) ;// Error
    console.log('오류발생 : ', error.message);  // 문제가 발생했습니다!!!

}


finally 블록
- 블록은 선택적으로 사용할 수 있으며, try...catch가 끝난 후 반드시 실행되는 코드
- 오류 발생여부와 관계없이 실행
- 주로 리소스를 정리하는데 사용

try {
    console.log("코드를 실행합니다.")

    console.log("코드를 종료합니다.")
} catch(error) {
    console.log("에러가 발생했습니다..")
} finally {
    console.log('오류와 관계없이 항상 실행됩니다.')
}


다양한 에러 처리

