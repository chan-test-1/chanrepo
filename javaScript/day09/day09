const urlRegex = /(https?\:\/\/)?(www\.)?[a-zA-z0-9.-]+\.[a-zA-Z]{2,}(\/[^\s]*)?/i
;// (/https?\:\/\/)?  ?는 앞에문자, 문장이 올수도있고 안올수도있고 s가 올수도있고 안올수도있고 , https가 올수도있고 안올수도있고
;// (\/[^\s]*) 도메인주소뒤에는 /jihoon 뭐 이런 값들이 들어갈 수 있다. 그래서  \/ (슬래쉬), [^\s] 대괄호의 ^ 는 부정. \s 는 공백문자. 공백문자를 제외한 모든문자  * 0개이상 
;// 마지막 i는 대소문자 구분없이!

console.log(urlRegex.test('hTTps://example.com')) ;//true
console.log(urlRegex.test('ftp://example.com')) ;//false

